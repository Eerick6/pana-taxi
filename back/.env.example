NODE_ENV=development

DB_HOST=db
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=taxi

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=taxi
MYSQL_USER=
MYSQL_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 — almacenamiento de archivos (fotos, documentos)
# Account ID: dashboard.cloudflare.com → R2 → Overview (esquina derecha)
# API token: R2 → Manage API tokens → Create (permisos: Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taxi-docs

ALLOWED_ORIGINS=

# Redis — requerido para escalar horizontalmente (múltiples instancias de API)
# En desarrollo apunta al contenedor: redis://redis:6379
# Sin este valor funciona en modo single-instance (una sola instancia de API)
REDIS_URL=redis://redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Admin SDK — FCM push notifications
# Path to service account JSON downloaded from Firebase Console
FCM_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# Mapbox — Directions API para cálculo de rutas y tarifas
# Sin este token el sistema usa Haversine (línea recta) como fallback
# Token en https://account.mapbox.com → Access tokens (usar public token o uno con scope directions:read)
MAPBOX_ACCESS_TOKEN=

# Email del dueño de la plataforma (se crea al primer arranque)
OWNER_EMAIL=

# Encriptación de datos sensibles (cédulas)
# Generar: openssl rand -hex 32
ENCRYPTION_KEY=
# Generar: openssl rand -hex 32
HMAC_SECRET=
